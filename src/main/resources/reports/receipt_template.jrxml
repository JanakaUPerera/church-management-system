<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="receipt_template" pageWidth="342" pageHeight="396" columnWidth="342"
              leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="a0bf2c1c-2a9c-44ce-90ea-fb312c9f0a31">
    <!-- Page is the physical 4.75in x 5.5in (342x396pt) receipt itself, matching docs/RECEIPT.pdf
         exactly - no invented frame or margin around it. backgroundImage is a single full-page
         render of that reference PDF (border, hole-punches, watermark seal and all), so every
         field position below was measured directly against it: see the coordinate-detection
         script this template was built from for the underlying pixel measurements. Values sit on
         each field's English label line (the middle of the pad's three - Sinhala/English/Tamil -
         label lines); left-column values share x=138, right-column values share x=240. -->
    <parameter name="backgroundImage" class="java.io.InputStream"/>
    <parameter name="receivedFrom" class="java.lang.String"/>
    <parameter name="branchChurch" class="java.lang.String"/>
    <parameter name="number" class="java.lang.String"/>
    <parameter name="titheAmount" class="java.lang.String"/>
    <parameter name="offeringsAmount" class="java.lang.String"/>
    <parameter name="churchServiceDate" class="java.lang.String"/>
    <parameter name="collectionWeek" class="java.lang.String"/>
    <parameter name="dateReceived" class="java.lang.String"/>
    <parameter name="hasOtherDonations" class="java.lang.Boolean"/>
    <parameter name="othersLabel" class="java.lang.String"/>
    <parameter name="othersValue" class="java.lang.String"/>
    <parameter name="totalLabel" class="java.lang.String"/>
    <parameter name="totalValue" class="java.lang.String"/>
    <parameter name="receiptLanguageIsSinhala" class="java.lang.Boolean"/>
    <parameter name="receiptLanguageIsTamil" class="java.lang.Boolean"/>
    <parameter name="receiptLanguageIsEnglish" class="java.lang.Boolean"/>
    <parameter name="receiptNo" class="java.lang.String"/>
    <parameter name="printedAt" class="java.lang.String"/>
    <parameter name="issuedBy" class="java.lang.String"/>
    <parameter name="cancelledWatermark" class="java.lang.String"/>

    <detail>
        <band height="396">
            <image scaleImage="FillFrame">
                <reportElement x="0" y="0" width="342" height="396" uuid="d1f1b111-1111-4111-8111-111111111101"/>
                <imageExpression><![CDATA[$P{backgroundImage}]]></imageExpression>
            </image>

            <textField textAdjust="ScaleFont">
                <reportElement x="138" y="137" width="168" height="18" uuid="d1f1b111-1111-4111-8111-111111111102"/>
                <textElement><font fontName="Noto Sans" size="10"/></textElement>
                <textFieldExpression><![CDATA[$P{receivedFrom}]]></textFieldExpression>
            </textField>
            <textField textAdjust="ScaleFont">
                <reportElement x="118" y="177" width="60" height="18" uuid="d1f1b111-1111-4111-8111-111111111103"/>
                <textElement><font fontName="Noto Sans" size="10"/></textElement>
                <textFieldExpression><![CDATA[$P{branchChurch}]]></textFieldExpression>
            </textField>
            <textField textAdjust="ScaleFont">
                <reportElement x="240" y="177" width="66" height="18" uuid="d1f1b111-1111-4111-8111-111111111104"/>
                <textElement><font fontName="Noto Sans" size="10"/></textElement>
                <textFieldExpression><![CDATA[$P{number}]]></textFieldExpression>
            </textField>
            <textField textAdjust="ScaleFont">
                <reportElement x="118" y="215" width="60" height="18" uuid="d1f1b111-1111-4111-8111-111111111105"/>
                <textElement><font fontName="Noto Sans" size="10"/></textElement>
                <textFieldExpression><![CDATA[$P{titheAmount}]]></textFieldExpression>
            </textField>
            <textField textAdjust="ScaleFont">
                <reportElement x="240" y="215" width="66" height="18" uuid="d1f1b111-1111-4111-8111-111111111106"/>
                <textElement><font fontName="Noto Sans" size="10"/></textElement>
                <textFieldExpression><![CDATA[$P{offeringsAmount}]]></textFieldExpression>
            </textField>
            <!-- Other Donations, own "Others" row directly under Offerings - only when the
                 receipt actually has one. No field of its own on the pad's design, so both label
                 and value are ours; label needs a font variant per language, value is numeric so
                 one field covers every language. -->
            <textField textAdjust="ScaleFont">
                <reportElement x="240" y="240" width="66" height="12" uuid="d1f1b111-1111-4111-8111-111111111171">
                    <printWhenExpression><![CDATA[$P{hasOtherDonations} && $P{receiptLanguageIsEnglish}]]></printWhenExpression>
                </reportElement>
                <textElement><font fontName="Noto Sans" size="9"/></textElement>
                <textFieldExpression><![CDATA[$P{othersLabel}]]></textFieldExpression>
            </textField>
            <textField textAdjust="ScaleFont">
                <reportElement x="240" y="240" width="66" height="12" uuid="d1f1b111-1111-4111-8111-111111111172">
                    <printWhenExpression><![CDATA[$P{hasOtherDonations} && $P{receiptLanguageIsSinhala}]]></printWhenExpression>
                </reportElement>
                <textElement><font fontName="Noto Sans Sinhala" size="9"/></textElement>
                <textFieldExpression><![CDATA[$P{othersLabel}]]></textFieldExpression>
            </textField>
            <textField textAdjust="ScaleFont">
                <reportElement x="240" y="240" width="66" height="12" uuid="d1f1b111-1111-4111-8111-111111111173">
                    <printWhenExpression><![CDATA[$P{hasOtherDonations} && $P{receiptLanguageIsTamil}]]></printWhenExpression>
                </reportElement>
                <textElement><font fontName="Noto Sans Tamil" size="9"/></textElement>
                <textFieldExpression><![CDATA[$P{othersLabel}]]></textFieldExpression>
            </textField>
            <textField textAdjust="ScaleFont">
                <reportElement x="240" y="252" width="66" height="14" uuid="d1f1b111-1111-4111-8111-111111111174">
                    <printWhenExpression><![CDATA[$P{hasOtherDonations}]]></printWhenExpression>
                </reportElement>
                <textElement><font fontName="Noto Sans" size="10"/></textElement>
                <textFieldExpression><![CDATA[$P{othersValue}]]></textFieldExpression>
            </textField>
            <!-- Total, own row under Offerings/Others - always shown, no field of its own on the
                 pad's design either. -->
            <textField textAdjust="ScaleFont">
                <reportElement x="240" y="268" width="66" height="12" uuid="d1f1b111-1111-4111-8111-111111111175">
                    <printWhenExpression><![CDATA[$P{receiptLanguageIsEnglish}]]></printWhenExpression>
                </reportElement>
                <textElement><font fontName="Noto Sans" size="9"/></textElement>
                <textFieldExpression><![CDATA[$P{totalLabel}]]></textFieldExpression>
            </textField>
            <textField textAdjust="ScaleFont">
                <reportElement x="240" y="268" width="66" height="12" uuid="d1f1b111-1111-4111-8111-111111111176">
                    <printWhenExpression><![CDATA[$P{receiptLanguageIsSinhala}]]></printWhenExpression>
                </reportElement>
                <textElement><font fontName="Noto Sans Sinhala" size="9"/></textElement>
                <textFieldExpression><![CDATA[$P{totalLabel}]]></textFieldExpression>
            </textField>
            <textField textAdjust="ScaleFont">
                <reportElement x="240" y="268" width="66" height="12" uuid="d1f1b111-1111-4111-8111-111111111177">
                    <printWhenExpression><![CDATA[$P{receiptLanguageIsTamil}]]></printWhenExpression>
                </reportElement>
                <textElement><font fontName="Noto Sans Tamil" size="9"/></textElement>
                <textFieldExpression><![CDATA[$P{totalLabel}]]></textFieldExpression>
            </textField>
            <textField textAdjust="ScaleFont">
                <reportElement x="240" y="280" width="66" height="14" uuid="d1f1b111-1111-4111-8111-111111111178"/>
                <textElement><font fontName="Noto Sans" size="10"/></textElement>
                <textFieldExpression><![CDATA[$P{totalValue}]]></textFieldExpression>
            </textField>
            <textField textAdjust="ScaleFont">
                <reportElement x="140" y="256" width="168" height="18" uuid="d1f1b111-1111-4111-8111-111111111107"/>
                <textElement><font fontName="Noto Sans" size="10"/></textElement>
                <textFieldExpression><![CDATA[$P{churchServiceDate}]]></textFieldExpression>
            </textField>
            <!-- Collection week range: its own line directly under the Date of church service
                 value (computed in ReceiptPdfGenerator) - no field of its own on the pad's
                 design. Font variant per language so the translated label renders correctly.
                 Starts at x=75 rather than x=37 to match receipt_print_template.jrxml, where the
                 dot-matrix printer's real left-edge clip (confirmed on an actual printout) sits
                 well past the requested 1.2cm margin - no such constraint applies to this preview
                 template, but positions are kept in sync per usual practice. -->
            <textField textAdjust="ScaleFont">
                <reportElement x="75" y="280" width="130" height="14" uuid="d1f1b111-1111-4111-8111-111111111170">
                    <printWhenExpression><![CDATA[$P{receiptLanguageIsEnglish}]]></printWhenExpression>
                </reportElement>
                <textElement><font fontName="Noto Sans" size="9"/></textElement>
                <textFieldExpression><![CDATA[$P{collectionWeek}]]></textFieldExpression>
            </textField>
            <textField textAdjust="ScaleFont">
                <reportElement x="75" y="280" width="130" height="14" uuid="d1f1b111-1111-4111-8111-111111111179">
                    <printWhenExpression><![CDATA[$P{receiptLanguageIsSinhala}]]></printWhenExpression>
                </reportElement>
                <textElement><font fontName="Noto Sans Sinhala" size="9"/></textElement>
                <textFieldExpression><![CDATA[$P{collectionWeek}]]></textFieldExpression>
            </textField>
            <textField textAdjust="ScaleFont">
                <reportElement x="75" y="280" width="130" height="14" uuid="d1f1b111-1111-4111-8111-111111111180">
                    <printWhenExpression><![CDATA[$P{receiptLanguageIsTamil}]]></printWhenExpression>
                </reportElement>
                <textElement><font fontName="Noto Sans Tamil" size="9"/></textElement>
                <textFieldExpression><![CDATA[$P{collectionWeek}]]></textFieldExpression>
            </textField>
            <!-- Date received value - three font variants, one per language (a plain date, no
                 translated text, but kept split for consistency and in case that changes). -->
            <textField textAdjust="ScaleFont">
                <reportElement x="118" y="300" width="168" height="18" uuid="d1f1b111-1111-4111-8111-111111111108">
                    <printWhenExpression><![CDATA[$P{receiptLanguageIsEnglish}]]></printWhenExpression>
                </reportElement>
                <textElement><font fontName="Noto Sans" size="10"/></textElement>
                <textFieldExpression><![CDATA[$P{dateReceived}]]></textFieldExpression>
            </textField>
            <textField textAdjust="ScaleFont">
                <reportElement x="118" y="300" width="168" height="18" uuid="d1f1b111-1111-4111-8111-111111111162">
                    <printWhenExpression><![CDATA[$P{receiptLanguageIsSinhala}]]></printWhenExpression>
                </reportElement>
                <textElement><font fontName="Noto Sans Sinhala" size="10"/></textElement>
                <textFieldExpression><![CDATA[$P{dateReceived}]]></textFieldExpression>
            </textField>
            <textField textAdjust="ScaleFont">
                <reportElement x="118" y="300" width="168" height="18" uuid="d1f1b111-1111-4111-8111-111111111163">
                    <printWhenExpression><![CDATA[$P{receiptLanguageIsTamil}]]></printWhenExpression>
                </reportElement>
                <textElement><font fontName="Noto Sans Tamil" size="10"/></textElement>
                <textFieldExpression><![CDATA[$P{dateReceived}]]></textFieldExpression>
            </textField>

            <!-- Cancelled watermark, overlaid diagonally across the main content -->
            <textField>
                <reportElement forecolor="#B00020" x="0" y="180" width="342" height="90" uuid="d1f1b111-1111-4111-8111-111111111109"/>
                <textElement textAlignment="Center" verticalAlignment="Middle" rotation="None"><font fontName="Noto Sans" size="24" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{cancelledWatermark}]]></textFieldExpression>
            </textField>

            <!-- Bottom white space below the footer bar: Receipt No / Printed At / Issued By,
                 value under label - the only fields on the card that aren't part of the pad's own
                 design (no room on the real pad for a fourth label row). Runs slightly past the
                 card's decorative border (bottom edge ~380pt) into the last ~16pt of true page
                 space (page height 396) - blank on the real pad either way, and box heights here
                 are intentionally generous (~1.5x font size): JasperReports computes text layout
                 at fill time using AWT font metrics for whatever font name is requested, and when
                 that family isn't actually installed as a system font (only registered for PDF
                 embedding), the substituted fallback font's metrics can exceed a tightly-sized box
                 and the whole line silently fails to render (in both the Graphics2D preview and
                 the PDF export) - confirmed the hard way with 10/13pt boxes here. -->
            <!-- x=75 rather than x=36 to match receipt_print_template.jrxml, where the printer's
                 real left-edge clip sits well past 34pt (confirmed on an actual printout -
                 "Receipt " was clipped off, leaving just "No:") - keeps the original right edge
                 (36+88=124); no such constraint applies to this preview template, but positions
                 are kept in sync per usual practice. -->
            <staticText>
                <reportElement x="75" y="358" width="49" height="15" uuid="d1f1b111-1111-4111-8111-111111111120"/>
                <textElement><font fontName="Noto Sans" size="8"/></textElement>
                <text><![CDATA[Receipt No:]]></text>
            </staticText>
            <textField textAdjust="ScaleFont">
                <reportElement x="75" y="366" width="49" height="18" uuid="d1f1b111-1111-4111-8111-111111111121"/>
                <textElement><font fontName="Noto Sans" size="9"/></textElement>
                <textFieldExpression><![CDATA[$P{receiptNo}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="125" y="358" width="88" height="15" uuid="d1f1b111-1111-4111-8111-111111111122"/>
                <textElement><font fontName="Noto Sans" size="8"/></textElement>
                <text><![CDATA[Printed At:]]></text>
            </staticText>
            <textField textAdjust="ScaleFont">
                <reportElement x="125" y="366" width="88" height="18" uuid="d1f1b111-1111-4111-8111-111111111123"/>
                <textElement><font fontName="Noto Sans" size="9"/></textElement>
                <textFieldExpression><![CDATA[$P{printedAt}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="217" y="358" width="84" height="15" uuid="d1f1b111-1111-4111-8111-111111111124"/>
                <textElement><font fontName="Noto Sans" size="8"/></textElement>
                <text><![CDATA[Issued By:]]></text>
            </staticText>
            <textField textAdjust="ScaleFont">
                <reportElement x="217" y="366" width="84" height="18" uuid="d1f1b111-1111-4111-8111-111111111125"/>
                <textElement><font fontName="Noto Sans" size="9"/></textElement>
                <textFieldExpression><![CDATA[$P{issuedBy}]]></textFieldExpression>
            </textField>
        </band>
    </detail>
</jasperReport>
