            <textField><reportElement style="header" x="335" y="0" width="67" height="22"/><textFieldExpression><![CDATA[$P{header6}]]></textFieldExpression></textField>
            <textField><reportElement style="header" x="402" y="0" width="67" height="22"/><textFieldExpression><![CDATA[$P{header7}]]></textFieldExpression></textField>
            <textField><reportElement style="header" x="469" y="0" width="67" height="22"/><textFieldExpression><![CDATA[$P{header8}]]></textFieldExpression></textField>
            <textField><reportElement style="header" x="536" y="0" width="67" height="22"/><textFieldExpression><![CDATA[$P{header9}]]></textFieldExpression></textField>
            <textField><reportElement style="header" x="603" y="0" width="67" height="22"/><textFieldExpression><![CDATA[$P{header10}]]></textFieldExpression></textField>
            <textField><reportElement style="header" x="670" y="0" width="66" height="22"/><textFieldExpression><![CDATA[$P{header11}]]></textFieldExpression></textField>
            <textField><reportElement style="header" x="736" y="0" width="66" height="22"/><textFieldExpression><![CDATA[$P{header12}]]></textFieldExpression></textField>
        </band>
    </columnHeader>
    <detail><band height="24">
            <textField><reportElement style="base" x="0" y="0" width="67" height="22"/><textFieldExpression><![CDATA[$F{column1}]]></textFieldExpression></textField>
            <textField><reportElement style="base" x="67" y="0" width="67" height="22"/><textFieldExpression><![CDATA[$F{column2}]]></textFieldExpression></textField>
            <textField><reportElement style="base" x="134" y="0" width="67" height="22"/><textFieldExpression><![CDATA[$F{column3}]]></textFieldExpression></textField>
            <textField><reportElement style="base" x="201" y="0" width="67" height="22"/><textFieldExpression><![CDATA[$F{column4}]]></textFieldExpression></textField>
            <textField><reportElement style="base" x="268" y="0" width="67" height="22"/><textFieldExpression><![CDATA[$F{column5}]]></textFieldExpression></textField>
            <textField><reportElement style="base" x="335" y="0" width="67" height="22"/><textFieldExpression><![CDATA[$F{column6}]]></textFieldExpression></textField>
            <textField><reportElement style="base" x="402" y="0" width="67" height="22"/><textFieldExpression><![CDATA[$F{column7}]]></textFieldExpression></textField>
            <textField><reportElement style="base" x="469" y="0" width="67" height="22"/><textFieldExpression><![CDATA[$F{column8}]]></textFieldExpression></textField>
            <textField><reportElement style="base" x="536" y="0" width="67" height="22"/><textFieldExpression><![CDATA[$F{column9}]]></textFieldExpression></textField>
            <textField><reportElement style="base" x="603" y="0" width="67" height="22"/><textFieldExpression><![CDATA[$F{column10}]]></textFieldExpression></textField>
            <textField><reportElement style="base" x="670" y="0" width="66" height="22"/><textFieldExpression><![CDATA[$F{column11}]]></textFieldExpression></textField>
            <textField><reportElement style="base" x="736" y="0" width="66" height="22"/><textFieldExpression><![CDATA[$F{column12}]]></textFieldExpression></textField>
        </band>
    </detail>
    <pageFooter><band height="22">
            <textField><reportElement style="base" x="680" y="0" width="122" height="18"/><textElement textAlignment="Right"/><textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER}]]></textFieldExpression></textField>
        </band>
    </pageFooter>
</jasperReport>
