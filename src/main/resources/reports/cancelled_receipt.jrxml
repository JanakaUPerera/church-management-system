    <parameter name="header10" class="java.lang.String"/>
    <parameter name="header11" class="java.lang.String"/>
    <parameter name="header12" class="java.lang.String"/>
    <field name="column1" class="java.lang.String"/>
    <field name="column2" class="java.lang.String"/>
    <field name="column3" class="java.lang.String"/>
    <field name="column4" class="java.lang.String"/>
    <field name="column5" class="java.lang.String"/>
    <field name="column6" class="java.lang.String"/>
    <field name="column7" class="java.lang.String"/>
    <field name="column8" class="java.lang.String"/>
    <field name="column9" class="java.lang.String"/>
    <field name="column10" class="java.lang.String"/>
    <field name="column11" class="java.lang.String"/>
    <field name="column12" class="java.lang.String"/>
    <title>
        <band height="112">
            <textField><reportElement style="header" x="0" y="0" width="802" height="22"/><textElement textAlignment="Center"/><textFieldExpression><![CDATA[$P{organizationName}]]></textFieldExpression></textField>
            <textField><reportElement style="header" x="0" y="26" width="802" height="22"/><textElement textAlignment="Center"/><textFieldExpression><![CDATA[$P{reportTitle}]]></textFieldExpression></textField>
            <textField><reportElement style="base" x="0" y="54" width="802" height="18"/><textFieldExpression><![CDATA["Generated: " + $P{generatedAt} + "    Rows: " + $P{rowCount}]]></textFieldExpression></textField>
            <textField><reportElement style="base" x="0" y="78" width="802" height="28"/><textFieldExpression><![CDATA[$P{filters}]]></textFieldExpression></textField>
        </band>
    </title>
    <columnHeader><band height="24">
            <textField><reportElement style="header" x="0" y="0" width="67" height="22"/><textFieldExpression><![CDATA[$P{header1}]]></textFieldExpression></textField>
            <textField><reportElement style="header" x="67" y="0" width="67" height="22"/><textFieldExpression><![CDATA[$P{header2}]]></textFieldExpression></textField>
            <textField><reportElement style="header" x="134" y="0" width="67" height="22"/><textFieldExpression><![CDATA[$P{header3}]]></textFieldExpression></textField>
            <textField><reportElement style="header" x="201" y="0" width="67" height="22"/><textFieldExpression><![CDATA[$P{header4}]]></textFieldExpression></textField>
