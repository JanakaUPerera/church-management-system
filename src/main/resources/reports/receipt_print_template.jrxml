<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="receipt_print_template" pageWidth="342" pageHeight="396" columnWidth="342"
              leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="a0bf2c1c-2a9c-44ce-90ea-fb312c9f0a32">
    <!-- Text-only counterpart of receipt_template.jrxml, for printing directly onto the
         pre-printed physical receipt pad on the dot-matrix printer: no background image, border,
         or hole-punch marks - those already exist on the paper stock. Field positions are
         identical to receipt_template.jrxml (both templates share the same 342x396pt page - the
         physical 4.75in x 5.5in receipt itself, matching docs/RECEIPT.pdf exactly - so no
         coordinate translation between the two is needed). The printable area within the
         printer's physical margins is enforced by the print job's Paper/imageable-area at print
         time (DotMatrixReceiptPrinterService), not by this template. -->
    <parameter name="receivedFrom" class="java.lang.String"/>
    <parameter name="branchChurch" class="java.lang.String"/>
    <parameter name="number" class="java.lang.String"/>
    <parameter name="titheAmount" class="java.lang.String"/>
    <parameter name="offeringsAmount" class="java.lang.String"/>
    <parameter name="churchServiceDate" class="java.lang.String"/>
    <parameter name="collectionWeek" class="java.lang.String"/>
    <parameter name="dateReceived" class="java.lang.String"/>
    <parameter name="receiptLanguageIsSinhala" class="java.lang.Boolean"/>
    <parameter name="receiptLanguageIsTamil" class="java.lang.Boolean"/>
    <parameter name="receiptLanguageIsEnglish" class="java.lang.Boolean"/>
    <parameter name="receiptNo" class="java.lang.String"/>
    <parameter name="printedAt" class="java.lang.String"/>
    <parameter name="issuedBy" class="java.lang.String"/>
    <parameter name="cancelledWatermark" class="java.lang.String"/>

    <detail>
        <band height="396">
            <textField textAdjust="ScaleFont">
                <reportElement x="138" y="137" width="168" height="18" uuid="d1f1b111-1111-4111-8111-111111111201"/>
                <textElement><font fontName="Noto Sans" size="12"/></textElement>
                <textFieldExpression><![CDATA[$P{receivedFrom}]]></textFieldExpression>
            </textField>
            <textField textAdjust="ScaleFont">
                <reportElement x="138" y="177" width="60" height="18" uuid="d1f1b111-1111-4111-8111-111111111202"/>
                <textElement><font fontName="Noto Sans" size="12"/></textElement>
                <textFieldExpression><![CDATA[$P{branchChurch}]]></textFieldExpression>
            </textField>
            <textField textAdjust="ScaleFont">
                <reportElement x="240" y="177" width="66" height="18" uuid="d1f1b111-1111-4111-8111-111111111203"/>
                <textElement><font fontName="Noto Sans" size="12"/></textElement>
                <textFieldExpression><![CDATA[$P{number}]]></textFieldExpression>
            </textField>
            <textField textAdjust="ScaleFont">
                <reportElement x="138" y="217" width="60" height="18" uuid="d1f1b111-1111-4111-8111-111111111204"/>
                <textElement><font fontName="Noto Sans" size="12"/></textElement>
                <textFieldExpression><![CDATA[$P{titheAmount}]]></textFieldExpression>
            </textField>
            <textField textAdjust="ScaleFont">
                <reportElement x="240" y="217" width="66" height="18" uuid="d1f1b111-1111-4111-8111-111111111205"/>
                <textElement><font fontName="Noto Sans" size="12"/></textElement>
                <textFieldExpression><![CDATA[$P{offeringsAmount}]]></textFieldExpression>
            </textField>
            <textField textAdjust="ScaleFont">
                <reportElement x="138" y="256" width="168" height="18" uuid="d1f1b111-1111-4111-8111-111111111206"/>
                <textElement><font fontName="Noto Sans" size="12"/></textElement>
                <textFieldExpression><![CDATA[$P{churchServiceDate}]]></textFieldExpression>
            </textField>
            <!-- Collection week range: its own line directly under the Date of church service
                 value (computed in ReceiptPdfGenerator) - no field of its own on the pad's
                 design. -->
            <textField textAdjust="ScaleFont">
                <reportElement x="138" y="276" width="168" height="18" uuid="d1f1b111-1111-4111-8111-111111111218"/>
                <textElement><font fontName="Noto Sans" size="12"/></textElement>
                <textFieldExpression><![CDATA[$P{collectionWeek}]]></textFieldExpression>
            </textField>
            <textField textAdjust="ScaleFont">
                <reportElement x="138" y="300" width="168" height="18" uuid="d1f1b111-1111-4111-8111-111111111208">
                    <printWhenExpression><![CDATA[$P{receiptLanguageIsEnglish}]]></printWhenExpression>
                </reportElement>
                <textElement><font fontName="Noto Sans" size="12"/></textElement>
                <textFieldExpression><![CDATA[$P{dateReceived}]]></textFieldExpression>
            </textField>
            <textField textAdjust="ScaleFont">
                <reportElement x="138" y="300" width="168" height="18" uuid="d1f1b111-1111-4111-8111-111111111209">
                    <printWhenExpression><![CDATA[$P{receiptLanguageIsSinhala}]]></printWhenExpression>
                </reportElement>
                <textElement><font fontName="Noto Sans Sinhala" size="12"/></textElement>
                <textFieldExpression><![CDATA[$P{dateReceived}]]></textFieldExpression>
            </textField>
            <textField textAdjust="ScaleFont">
                <reportElement x="138" y="300" width="168" height="18" uuid="d1f1b111-1111-4111-8111-111111111210">
                    <printWhenExpression><![CDATA[$P{receiptLanguageIsTamil}]]></printWhenExpression>
                </reportElement>
                <textElement><font fontName="Noto Sans Tamil" size="12"/></textElement>
                <textFieldExpression><![CDATA[$P{dateReceived}]]></textFieldExpression>
            </textField>

            <!-- Cancelled watermark: kept for parity with receipt_template.jrxml, though in
                 practice printOriginalReceipt() already refuses to print cancelled receipts,
                 so this text is always empty on anything that actually reaches the printer. -->
            <textField>
                <reportElement forecolor="#B00020" x="0" y="180" width="342" height="90" uuid="d1f1b111-1111-4111-8111-111111111211"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Noto Sans" size="24" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{cancelledWatermark}]]></textFieldExpression>
            </textField>

            <!-- Box heights here are intentionally generous (~1.5x font size) - see
                 receipt_template.jrxml for why tightly-sized boxes silently fail to render. -->
            <staticText>
                <reportElement x="36" y="360" width="88" height="15" uuid="d1f1b111-1111-4111-8111-111111111212"/>
                <textElement><font fontName="Noto Sans" size="10"/></textElement>
                <text><![CDATA[Receipt No:]]></text>
            </staticText>
            <textField textAdjust="ScaleFont">
                <reportElement x="36" y="375" width="88" height="18" uuid="d1f1b111-1111-4111-8111-111111111213"/>
                <textElement><font fontName="Noto Sans" size="12"/></textElement>
                <textFieldExpression><![CDATA[$P{receiptNo}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="130" y="360" width="88" height="15" uuid="d1f1b111-1111-4111-8111-111111111214"/>
                <textElement><font fontName="Noto Sans" size="10"/></textElement>
                <text><![CDATA[Printed At:]]></text>
            </staticText>
            <textField textAdjust="ScaleFont">
                <reportElement x="130" y="375" width="88" height="18" uuid="d1f1b111-1111-4111-8111-111111111215"/>
                <textElement><font fontName="Noto Sans" size="12"/></textElement>
                <textFieldExpression><![CDATA[$P{printedAt}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="222" y="360" width="84" height="15" uuid="d1f1b111-1111-4111-8111-111111111216"/>
                <textElement><font fontName="Noto Sans" size="10"/></textElement>
                <text><![CDATA[Issued By:]]></text>
            </staticText>
            <textField textAdjust="ScaleFont">
                <reportElement x="222" y="375" width="84" height="18" uuid="d1f1b111-1111-4111-8111-111111111217"/>
                <textElement><font fontName="Noto Sans" size="12"/></textElement>
                <textFieldExpression><![CDATA[$P{issuedBy}]]></textFieldExpression>
            </textField>
        </band>
    </detail>
</jasperReport>
