<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Pagination?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="14" styleClass="module-page"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.churchmanagement.controller.ActivityLogController">
    <padding>
        <Insets bottom="22" left="22" right="22" top="22"/>
    </padding>

    <Label styleClass="placeholder-title" text="Activity Logs"/>

    <GridPane hgap="12" vgap="10">
        <columnConstraints>
            <ColumnConstraints minWidth="90" prefWidth="110"/>
            <ColumnConstraints minWidth="170" prefWidth="220"/>
            <ColumnConstraints minWidth="90" prefWidth="110"/>
            <ColumnConstraints minWidth="170" prefWidth="220"/>
            <ColumnConstraints minWidth="90" prefWidth="110"/>
            <ColumnConstraints hgrow="ALWAYS" minWidth="150" prefWidth="220"/>
        </columnConstraints>

        <Label text="Date From" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <DatePicker fx:id="dateFromPicker" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
        <Label text="Date To" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
        <DatePicker fx:id="dateToPicker" maxWidth="Infinity" GridPane.columnIndex="3" GridPane.rowIndex="0"/>
        <Label text="User" GridPane.columnIndex="4" GridPane.rowIndex="0"/>
        <ComboBox fx:id="userComboBox" maxWidth="Infinity" GridPane.columnIndex="5" GridPane.rowIndex="0"/>

        <Label text="Action" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <ComboBox fx:id="actionComboBox" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
        <Label text="Module" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
        <ComboBox fx:id="moduleComboBox" maxWidth="Infinity" GridPane.columnIndex="3" GridPane.rowIndex="1"/>
        <Label text="Keyword" GridPane.columnIndex="4" GridPane.rowIndex="1"/>
        <TextField fx:id="keywordField" GridPane.columnIndex="5" GridPane.rowIndex="1"/>

        <HBox alignment="CENTER_RIGHT" spacing="8" GridPane.columnIndex="3" GridPane.columnSpan="3" GridPane.rowIndex="2">
            <Button fx:id="searchButton" onAction="#handleSearch" styleClass="primary-button" text="Search"/>
            <Button fx:id="clearButton" onAction="#handleClear" text="Clear"/>
            <Button fx:id="viewDetailsButton" onAction="#handleViewDetails" text="View Details"/>
            <Button fx:id="refreshButton" onAction="#handleRefresh" text="Refresh"/>
        </HBox>
    </GridPane>

    <TableView fx:id="activityLogTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="dateTimeColumn" prefWidth="145" text="Date/Time"/>
            <TableColumn fx:id="userColumn" prefWidth="160" text="User"/>
            <TableColumn fx:id="actionColumn" prefWidth="170" text="Action"/>
            <TableColumn fx:id="moduleColumn" prefWidth="130" text="Module"/>
            <TableColumn fx:id="recordIdColumn" prefWidth="120" text="Record ID"/>
            <TableColumn fx:id="machineColumn" prefWidth="135" text="Machine"/>
            <TableColumn fx:id="descriptionColumn" prefWidth="260" text="Description"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>

    <HBox alignment="CENTER_LEFT" spacing="10" styleClass="table-pagination-bar" VBox.vgrow="NEVER">
        <Label styleClass="pagination-label" text="Activity logs per page"/>
        <ComboBox fx:id="activityLogItemsPerPageComboBox" prefWidth="76" styleClass="items-per-page-combo"/>
        <Label fx:id="activityLogPaginationSummaryLabel" styleClass="pagination-summary" text="0 of 0 activity logs"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="messageLabel" styleClass="form-message"/>
        <Pagination fx:id="activityLogPagination" maxHeight="48"/>
    </HBox>
</VBox>
