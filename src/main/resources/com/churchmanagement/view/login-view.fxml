<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.churchmanagement.controller.LoginController">
    <center>
        <VBox alignment="CENTER" maxWidth="320" spacing="14">
            <padding>
                <Insets bottom="32" left="32" right="32" top="32"/>
            </padding>

            <Label style="-fx-font-size: 24px; -fx-font-weight: bold;" text="Church Management"/>
            <Label style="-fx-text-fill: #5f6b7a;" text="Sign in to continue"/>

            <TextField fx:id="usernameField"
                       prefHeight="35"
                       promptText="Username"
                       style="-fx-font-size: 14px;"/>
            <PasswordField fx:id="passwordField"
                           prefHeight="35"
                           promptText="Password"
                           style="-fx-font-size: 14px;"/>
            <Button defaultButton="true"
                    maxWidth="Infinity"
                    onAction="#handleLogin"
                    prefHeight="35"
                    style="-fx-font-size: 14px;"
                    text="Login"/>
            <Label fx:id="messageLabel" style="-fx-text-fill: #b42318;"/>
        </VBox>
    </center>
</BorderPane>
