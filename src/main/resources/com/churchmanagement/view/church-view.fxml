<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Pagination?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16" styleClass="module-page"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.churchmanagement.controller.ChurchController">
    <padding>
        <Insets bottom="22" left="22" right="22" top="22"/>
    </padding>

    <GridPane hgap="14" vgap="10">
        <columnConstraints>
            <ColumnConstraints minWidth="100" prefWidth="110"/>
            <ColumnConstraints minWidth="150" prefWidth="180"/>
            <ColumnConstraints minWidth="110" prefWidth="120"/>
            <ColumnConstraints hgrow="ALWAYS" minWidth="280" prefWidth="420"/>
        </columnConstraints>
        <Label text="Church Code" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <TextField fx:id="churchCodeField" promptText="CH001" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
        <Label text="Church Name" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
        <TextField fx:id="churchNameField" prefWidth="420" promptText="Main Church" GridPane.columnIndex="3" GridPane.rowIndex="0"/>
        <Label text="Region" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <ComboBox fx:id="regionComboBox" prefWidth="180" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
        <Label text="Status" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
        <ComboBox fx:id="statusComboBox" prefWidth="180" GridPane.columnIndex="3" GridPane.rowIndex="1"/>
    </GridPane>

    <Label styleClass="section-title" text="Authorized Person &amp; SMS Details"/>
    <GridPane hgap="14" vgap="10">
        <columnConstraints>
            <ColumnConstraints minWidth="170" prefWidth="190"/>
            <ColumnConstraints minWidth="190" prefWidth="220"/>
            <ColumnConstraints minWidth="130" prefWidth="150"/>
            <ColumnConstraints hgrow="ALWAYS" minWidth="220" prefWidth="320"/>
        </columnConstraints>
        <Label text="Authorized Person Name" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <TextField fx:id="authorizedPersonNameField" promptText="Name" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
        <Label text="Position" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
        <ComboBox fx:id="authorizedPersonPositionComboBox" prefWidth="220" GridPane.columnIndex="3" GridPane.rowIndex="0"/>
        <Label fx:id="otherPositionLabel" text="Other Position" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <TextField fx:id="authorizedPersonPositionOtherField" promptText="Position" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
        <Label text="SMS Mobile Number" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
        <TextField fx:id="smsMobileNumberField" promptText="0771234567 or +94771234567" GridPane.columnIndex="3" GridPane.rowIndex="1"/>
    </GridPane>

    <HBox spacing="10">
        <Button fx:id="saveButton" onAction="#handleSave" styleClass="primary-button" text="Save"/>
        <Button fx:id="updateButton" onAction="#handleUpdate" text="Update"/>
        <Button fx:id="clearButton" onAction="#handleClear" text="Clear"/>
    </HBox>

    <HBox alignment="CENTER_LEFT" spacing="10">
        <TextField fx:id="searchField" HBox.hgrow="ALWAYS" onAction="#handleSearch" promptText="Search by church code, church name, or region name"/>
        <Button onAction="#handleSearch" text="Search"/>
        <Button onAction="#handleRefresh" text="Refresh"/>
    </HBox>

    <TableView fx:id="churchTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="codeColumn" prefWidth="120" text="Church Code"/>
            <TableColumn fx:id="nameColumn" prefWidth="220" text="Church Name"/>
            <TableColumn fx:id="regionColumn" prefWidth="210" text="Region"/>
            <TableColumn fx:id="authorizedPersonColumn" prefWidth="180" text="Authorized Person"/>
            <TableColumn fx:id="smsMobileNumberColumn" prefWidth="150" text="SMS Mobile Number"/>
            <TableColumn fx:id="statusColumn" prefWidth="110" text="Status"/>
            <TableColumn fx:id="actionColumn" prefWidth="120" text="Action"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>

    <HBox alignment="CENTER_LEFT" spacing="10" styleClass="table-pagination-bar" VBox.vgrow="NEVER">
        <Label styleClass="pagination-label" text="Churches per page"/>
        <ComboBox fx:id="churchItemsPerPageComboBox" prefWidth="76" styleClass="items-per-page-combo"/>
        <Label fx:id="churchPaginationSummaryLabel" styleClass="pagination-summary" text="0 of 0 Churches"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Pagination fx:id="churchPagination" maxHeight="48"/>
    </HBox>

    <Label fx:id="messageLabel" styleClass="form-message"/>
</VBox>
