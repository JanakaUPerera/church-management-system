<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Pagination?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="14" styleClass="module-page"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.churchmanagement.controller.SmsLogController">
    <padding>
        <Insets bottom="22" left="22" right="22" top="22"/>
    </padding>

    <GridPane hgap="12" vgap="10">
        <columnConstraints>
            <ColumnConstraints minWidth="90" prefWidth="110"/>
            <ColumnConstraints minWidth="170" prefWidth="220"/>
            <ColumnConstraints minWidth="90" prefWidth="110"/>
            <ColumnConstraints minWidth="170" prefWidth="220"/>
            <ColumnConstraints minWidth="90" prefWidth="110"/>
            <ColumnConstraints hgrow="ALWAYS" minWidth="150" prefWidth="220"/>
        </columnConstraints>

        <Label text="Date From" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <DatePicker fx:id="dateFromPicker" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
        <Label text="Date To" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
        <DatePicker fx:id="dateToPicker" maxWidth="Infinity" GridPane.columnIndex="3" GridPane.rowIndex="0"/>
        <Label text="Church" GridPane.columnIndex="4" GridPane.rowIndex="0"/>
        <ComboBox fx:id="churchComboBox" maxWidth="Infinity" GridPane.columnIndex="5" GridPane.rowIndex="0"/>

        <Label text="Status" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <ComboBox fx:id="statusComboBox" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
        <Label text="Mobile Number" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
        <TextField fx:id="mobileNumberField" GridPane.columnIndex="3" GridPane.rowIndex="1"/>
        <Label text="Receipt No" GridPane.columnIndex="4" GridPane.rowIndex="1"/>
        <TextField fx:id="receiptNoField" GridPane.columnIndex="5" GridPane.rowIndex="1"/>

        <HBox spacing="8" GridPane.columnIndex="4" GridPane.columnSpan="2" GridPane.rowIndex="2">
            <Button fx:id="searchButton" onAction="#handleSearch" styleClass="primary-button" text="Search"/>
            <Button fx:id="clearButton" onAction="#handleClear" text="Clear"/>
        </HBox>
    </GridPane>

    <TableView fx:id="smsLogTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="dateTimeColumn" prefWidth="145" text="Date/Time"/>
            <TableColumn fx:id="receiptNoColumn" prefWidth="125" text="Receipt No"/>
            <TableColumn fx:id="churchCodeColumn" prefWidth="105" text="Church Code"/>
            <TableColumn fx:id="churchNameColumn" prefWidth="190" text="Church Name"/>
            <TableColumn fx:id="mobileNumberColumn" prefWidth="135" text="Mobile Number"/>
            <TableColumn fx:id="providerColumn" prefWidth="150" text="Provider"/>
            <TableColumn fx:id="statusColumn" prefWidth="155" text="Status"/>
            <TableColumn fx:id="actionColumn" maxWidth="135" minWidth="110" prefWidth="120" resizable="false" text="Action"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>

    <HBox alignment="CENTER_LEFT" spacing="10" styleClass="table-pagination-bar" VBox.vgrow="NEVER">
        <Label styleClass="pagination-label" text="SMS logs per page"/>
        <ComboBox fx:id="smsLogItemsPerPageComboBox" prefWidth="76" styleClass="items-per-page-combo"/>
        <Label fx:id="smsLogPaginationSummaryLabel" styleClass="pagination-summary" text="0 of 0 SMS logs"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="messageLabel" styleClass="form-message"/>
        <Pagination fx:id="smsLogPagination" maxHeight="48"/>
    </HBox>
</VBox>
