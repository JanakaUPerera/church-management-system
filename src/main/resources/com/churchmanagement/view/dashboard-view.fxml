<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane styleClass="dashboard-root"
            stylesheets="@app.css"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.churchmanagement.controller.DashboardController">
    <top>
        <HBox fx:id="appHeader" alignment="CENTER_LEFT" spacing="18" styleClass="app-header">
            <padding>
                <Insets bottom="14" left="22" right="22" top="14"/>
            </padding>
            <HBox alignment="CENTER_LEFT" spacing="12" styleClass="brand-wrap">
                <ImageView fx:id="brandLogoImageView" fitHeight="42" fitWidth="42" preserveRatio="true" smooth="true" styleClass="brand-logo">
                    <image>
                        <Image url="@images/gethsemana_logo.jpg"/>
                    </image>
                </ImageView>
                <VBox alignment="CENTER_LEFT" spacing="1">
                    <Label fx:id="organizationNameLabel" styleClass="organization-name" text="Church Management System"/>
                </VBox>
            </HBox>
            <Region HBox.hgrow="ALWAYS"/>
            <StackPane styleClass="header-avatar">
                <ImageView fx:id="profileImageView" fitHeight="42" fitWidth="42" preserveRatio="true"/>
                <Label fx:id="profileAvatarLabel" styleClass="header-avatar-initials" text="?"/>
            </StackPane>
            <VBox alignment="CENTER_RIGHT" spacing="2">
                <Label fx:id="fullNameLabel" styleClass="header-user-name"/>
                <Label fx:id="roleNameLabel" styleClass="header-user-role"/>
            </VBox>
            <Button fx:id="myProfileButton" onAction="#showMyProfile" styleClass="header-profile-button" text="My Profile"/>
            <Button fx:id="logoutButton" onAction="#handleLogout" styleClass="logout-button" text="Logout"/>
            <Button fx:id="minimizeWindowButton" onAction="#minimizeWindow" styleClass="window-control-button"/>
            <Button fx:id="maximizeWindowButton" onAction="#toggleMaximizeWindow" styleClass="window-control-button"/>
        </HBox>
    </top>

    <left>
        <VBox fx:id="sidebar" minWidth="235" prefWidth="235" spacing="4" styleClass="sidebar">
            <padding>
                <Insets bottom="16" left="14" right="14" top="16"/>
            </padding>
            <Button fx:id="sidebarToggleButton" maxWidth="Infinity" onAction="#toggleSidebar" styleClass="sidebar-toggle-button"/>
            <VBox fx:id="sidebarHeaderBox" spacing="4" styleClass="nav-sidebar-header"/>
            <VBox fx:id="sidebarItemsBox" spacing="4"/>
        </VBox>
    </left>

    <center>
        <VBox spacing="16" styleClass="content-wrap">
            <padding>
                <Insets bottom="22" left="24" right="24" top="22"/>
            </padding>
            <HBox fx:id="breadcrumbBar" alignment="CENTER_LEFT" spacing="8" styleClass="breadcrumb-bar"/>
            <StackPane fx:id="contentPane" VBox.vgrow="ALWAYS"/>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="status-bar">
            <padding>
                <Insets bottom="6" left="18" right="18" top="6"/>
            </padding>
            <VBox spacing="2">
                <HBox alignment="CENTER_LEFT" spacing="6">
                    <Label fx:id="versionLabel" styleClass="value-label"/>
                    <Label styleClass="status-separator" text="|"/>
                    <Label fx:id="statusLabel" styleClass="value-label status-ready" text="Ready"/>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="4">
                    <Label styleClass="footer-developer-label" text="Developed by Janaka Perera"/>
                    <FontIcon iconLiteral="fas-phone-alt" styleClass="footer-contact-icon"/>
                    <Label styleClass="footer-developer-label" text="077 915 6683"/>
                </HBox>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <HBox alignment="CENTER" spacing="6" styleClass="connection-status">
                <StackPane fx:id="modemStatusBadge" styleClass="connection-status-badge">
                    <FontIcon iconLiteral="fas-sms" styleClass="connection-status-icon"/>
                </StackPane>
                <Label styleClass="value-label" text="Modem:"/>
                <Label fx:id="modemStatusLabel" styleClass="status-value-badge" text="Checking"/>
            </HBox>
            <HBox alignment="CENTER" spacing="6" styleClass="database-status">
                <StackPane fx:id="databaseStatusBadge" styleClass="connection-status-badge">
                    <FontIcon iconLiteral="fas-database" styleClass="connection-status-icon"/>
                </StackPane>
                <Label styleClass="value-label" text="Database:"/>
                <Label fx:id="databaseStatusLabel" styleClass="status-value-badge" text="Checking"/>
            </HBox>
            <Label fx:id="dateLabel" styleClass="value-label"/>
        </HBox>
    </bottom>
</BorderPane>
