<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="dashboard-root"
            stylesheets="@app.css"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.churchmanagement.controller.DashboardController">
    <top>
        <HBox fx:id="appHeader" alignment="CENTER_LEFT" spacing="18" styleClass="app-header">
            <padding>
                <Insets bottom="14" left="22" right="22" top="14"/>
            </padding>
            <Label styleClass="app-name" text="Church Management System"/>
            <Region HBox.hgrow="ALWAYS"/>
            <VBox alignment="CENTER_RIGHT" spacing="2">
                <Label fx:id="fullNameLabel" styleClass="header-user-name"/>
                <Label fx:id="roleNameLabel" styleClass="header-user-role"/>
            </VBox>
            <Button fx:id="logoutButton" onAction="#handleLogout" styleClass="logout-button" text="Logout"/>
            <Button fx:id="minimizeWindowButton" onAction="#minimizeWindow" styleClass="window-control-button"/>
            <Button fx:id="maximizeWindowButton" onAction="#toggleMaximizeWindow" styleClass="window-control-button"/>
        </HBox>
    </top>

    <left>
        <VBox fx:id="sidebar" minWidth="235" prefWidth="235" spacing="4" styleClass="sidebar">
            <padding>
                <Insets bottom="16" left="14" right="14" top="16"/>
            </padding>
            <Button fx:id="sidebarToggleButton" maxWidth="Infinity" onAction="#toggleSidebar" styleClass="sidebar-toggle-button"/>
            <Button fx:id="dashboardButton" maxWidth="Infinity" onAction="#showDashboard" styleClass="menu-button" text="Dashboard"/>
            <Button fx:id="regionsButton" maxWidth="Infinity" onAction="#showRegions" styleClass="menu-button" text="Regions"/>
            <Button fx:id="churchesButton" maxWidth="Infinity" onAction="#showChurches" styleClass="menu-button" text="Churches"/>
            <Button fx:id="weeklyReceiptsButton" maxWidth="Infinity" onAction="#showWeeklyReceipts" styleClass="menu-button" text="Receipt"/>
            <Button fx:id="receiptHistoryButton" maxWidth="Infinity" onAction="#showReceiptHistory" styleClass="menu-button" text="Receipt History"/>
            <Button fx:id="reportsButton" maxWidth="Infinity" onAction="#showReports" styleClass="menu-button" text="Reports"/>
            <Button fx:id="usersButton" maxWidth="Infinity" onAction="#showUsers" styleClass="menu-button" text="Users"/>
            <Button fx:id="rolesButton" maxWidth="Infinity" onAction="#showRoles" styleClass="menu-button" text="Roles &amp; Permissions"/>
            <Button fx:id="backupButton" maxWidth="Infinity" onAction="#showBackup" styleClass="menu-button" text="Backup &amp; Restore"/>
            <Button fx:id="activityLogsButton" maxWidth="Infinity" onAction="#showActivityLogs" styleClass="menu-button" text="Activity Logs"/>
            <Button fx:id="smsLogsButton" maxWidth="Infinity" onAction="#showSmsLogs" styleClass="menu-button" text="SMS Logs"/>
            <Button fx:id="settingsButton" maxWidth="Infinity" onAction="#showSettings" styleClass="menu-button" text="Settings"/>
        </VBox>
    </left>

    <center>
        <VBox spacing="16" styleClass="content-wrap">
            <padding>
                <Insets bottom="22" left="24" right="24" top="22"/>
            </padding>
            <Label fx:id="pageTitleLabel" styleClass="page-title"/>
            <StackPane fx:id="contentPane" VBox.vgrow="ALWAYS"/>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="status-bar">
            <padding>
                <Insets bottom="8" left="18" right="18" top="8"/>
            </padding>
            <Label fx:id="statusLabel" styleClass="value-label" text="Ready"/>
            <Region HBox.hgrow="ALWAYS"/>
            <HBox alignment="CENTER" spacing="6" styleClass="database-status">
                <Label fx:id="databaseStatusDot" styleClass="database-status-dot"/>
                <Label fx:id="databaseStatusLabel" styleClass="value-label" text="Database: Checking..."/>
            </HBox>
            <Label fx:id="dateLabel" styleClass="value-label"/>
        </HBox>
    </bottom>
</BorderPane>
