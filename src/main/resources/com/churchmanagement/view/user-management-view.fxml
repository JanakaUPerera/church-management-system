<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Pagination?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16" styleClass="module-page"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.churchmanagement.controller.UserManagementController">
    <padding>
        <Insets bottom="22" left="22" right="22" top="22"/>
    </padding>

    <HBox alignment="CENTER_RIGHT" spacing="10">
        <Label fx:id="messageLabel" HBox.hgrow="ALWAYS" styleClass="form-message"/>
        <Button fx:id="saveButton" onAction="#handleSave" styleClass="primary-button" text="New User"/>
    </HBox>

    <HBox alignment="CENTER_RIGHT" spacing="10">
        <TextField fx:id="searchField" HBox.hgrow="ALWAYS" onAction="#handleSearch" promptText="Search by username, full name, or role"/>
        <Button fx:id="searchButton" onAction="#handleSearch" text="Search"/>
        <Button fx:id="refreshButton" onAction="#handleRefresh" text="Refresh"/>
    </HBox>

    <TableView fx:id="userTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="usernameColumn" prefWidth="150" text="Username"/>
            <TableColumn fx:id="fullNameColumn" prefWidth="220" text="Full Name"/>
            <TableColumn fx:id="roleColumn" prefWidth="150" text="Role"/>
            <TableColumn fx:id="statusColumn" prefWidth="110" text="Status"/>
            <TableColumn fx:id="forcePasswordChangeColumn" prefWidth="165" text="Force Password Change"/>
            <TableColumn fx:id="createdAtColumn" prefWidth="160" text="Created At"/>
            <TableColumn fx:id="actionColumn" prefWidth="130" text="Action"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>

    <HBox alignment="CENTER_LEFT" spacing="10" styleClass="table-pagination-bar" VBox.vgrow="NEVER">
        <Label styleClass="pagination-label" text="Users per page"/>
        <ComboBox fx:id="userItemsPerPageComboBox" prefWidth="76" styleClass="items-per-page-combo"/>
        <Label fx:id="userPaginationSummaryLabel" styleClass="pagination-summary" text="0 of 0 Users"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Pagination fx:id="userPagination" maxHeight="48"/>
    </HBox>
</VBox>
