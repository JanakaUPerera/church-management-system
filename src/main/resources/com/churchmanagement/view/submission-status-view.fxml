<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Pagination?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="14" styleClass="module-page"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.churchmanagement.controller.SubmissionStatusController">
    <padding>
        <Insets bottom="22" left="22" right="22" top="22"/>
    </padding>

    <GridPane hgap="12" vgap="10">
        <columnConstraints>
            <ColumnConstraints minWidth="120" prefWidth="135"/>
            <ColumnConstraints minWidth="160" prefWidth="190"/>
            <ColumnConstraints minWidth="120" prefWidth="130"/>
            <ColumnConstraints minWidth="190" prefWidth="230"/>
            <ColumnConstraints minWidth="90" prefWidth="100"/>
            <ColumnConstraints hgrow="ALWAYS" minWidth="160" prefWidth="190"/>
        </columnConstraints>

        <Label text="Week Start Date" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <DatePicker fx:id="weekStartDatePicker" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
        <Label text="Region" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
        <ComboBox fx:id="regionComboBox" maxWidth="Infinity" GridPane.columnIndex="3" GridPane.rowIndex="0"/>
        <Label text="Church" GridPane.columnIndex="4" GridPane.rowIndex="0"/>
        <ComboBox fx:id="churchComboBox" maxWidth="Infinity" GridPane.columnIndex="5" GridPane.rowIndex="0"/>

        <HBox alignment="CENTER_LEFT" spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="1" GridPane.columnSpan="2">
            <Button fx:id="previousWeekButton" onAction="#handlePreviousWeek" text="Previous Week"/>
            <Button fx:id="nextWeekButton" onAction="#handleNextWeek" text="Next Week"/>
        </HBox>

        <Label text="Status" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
        <ComboBox fx:id="statusComboBox" maxWidth="Infinity" GridPane.columnIndex="3" GridPane.rowIndex="1"/>
        <Label text="Search" GridPane.columnIndex="4" GridPane.rowIndex="1"/>
        <TextField fx:id="searchField" promptText="Search table" GridPane.columnIndex="5" GridPane.rowIndex="1"/>
    </GridPane>

    <GridPane hgap="10" vgap="10" styleClass="submission-kpi-grid">
        <columnConstraints>
            <ColumnConstraints hgrow="ALWAYS" percentWidth="12.5"/>
            <ColumnConstraints hgrow="ALWAYS" percentWidth="12.5"/>
            <ColumnConstraints hgrow="ALWAYS" percentWidth="12.5"/>
            <ColumnConstraints hgrow="ALWAYS" percentWidth="12.5"/>
            <ColumnConstraints hgrow="ALWAYS" percentWidth="12.5"/>
            <ColumnConstraints hgrow="ALWAYS" percentWidth="12.5"/>
            <ColumnConstraints hgrow="ALWAYS" percentWidth="12.5"/>
            <ColumnConstraints hgrow="ALWAYS" percentWidth="12.5"/>
        </columnConstraints>
        <VBox styleClass="dashboard-summary-card" GridPane.columnIndex="0" GridPane.rowIndex="0">
            <Label styleClass="dashboard-card-label" text="Submitted Churches"/>
            <Label fx:id="submittedChurchesLabel" styleClass="dashboard-card-value-small" text="0"/>
        </VBox>
        <VBox styleClass="dashboard-summary-card" GridPane.columnIndex="1" GridPane.rowIndex="0">
            <Label styleClass="dashboard-card-label" text="Pending Churches"/>
            <Label fx:id="pendingChurchesLabel" styleClass="dashboard-card-value-small" text="0"/>
        </VBox>
        <VBox styleClass="dashboard-summary-card" GridPane.columnIndex="2" GridPane.rowIndex="0">
            <Label styleClass="dashboard-card-label" text="Cancelled Receipts"/>
            <Label fx:id="cancelledReceiptsLabel" styleClass="dashboard-card-value-small" text="0"/>
        </VBox>
        <VBox styleClass="dashboard-summary-card" GridPane.columnIndex="3" GridPane.rowIndex="0">
            <Label styleClass="dashboard-card-label" text="Total Churches"/>
            <Label fx:id="totalChurchesLabel" styleClass="dashboard-card-value-small" text="0"/>
        </VBox>
        <VBox styleClass="dashboard-summary-card" GridPane.columnIndex="4" GridPane.rowIndex="0">
            <Label styleClass="dashboard-card-label" text="Late Submissions"/>
            <Label fx:id="lateSubmissionsLabel" styleClass="dashboard-card-value-small" text="0"/>
        </VBox>
        <VBox styleClass="dashboard-summary-card" GridPane.columnIndex="5" GridPane.rowIndex="0">
            <Label styleClass="dashboard-card-label" text="Total Collection"/>
            <Label fx:id="totalCollectionAmountLabel" styleClass="dashboard-card-value-small" text="0.00"/>
        </VBox>
        <VBox styleClass="dashboard-summary-card" GridPane.columnIndex="6" GridPane.rowIndex="0">
            <Label styleClass="dashboard-card-label" text="SMS Failed"/>
            <Label fx:id="smsFailedCountLabel" styleClass="dashboard-card-value-small" text="0"/>
        </VBox>
        <VBox styleClass="dashboard-summary-card" GridPane.columnIndex="7" GridPane.rowIndex="0">
            <Label styleClass="dashboard-card-label" text="Unprinted Receipts"/>
            <Label fx:id="unprintedReceiptsCountLabel" styleClass="dashboard-card-value-small" text="0"/>
        </VBox>
    </GridPane>

    <HBox alignment="CENTER_LEFT" spacing="12">
        <HBox alignment="CENTER_LEFT" maxWidth="Infinity" spacing="14" styleClass="submission-progress-band" HBox.hgrow="ALWAYS">
            <Label styleClass="submission-progress-title" text="Progress"/>
            <ProgressBar fx:id="submissionProgressBar" maxWidth="Infinity" progress="0" styleClass="submission-progress-bar" HBox.hgrow="ALWAYS"/>
            <Label fx:id="submissionProgressLabel" minWidth="130" styleClass="submission-progress-value" text="0 / 0      0%"/>
        </HBox>
        <Button fx:id="searchButton" onAction="#handleSearch" styleClass="primary-button" text="Search"/>
        <Button fx:id="refreshButton" onAction="#handleRefresh" text="Refresh"/>
    </HBox>

    <TableView fx:id="submissionStatusTable" styleClass="receipt-history-table" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="churchCodeColumn" prefWidth="95" text="Church Code"/>
            <TableColumn fx:id="churchNameColumn" prefWidth="180" text="Church Name"/>
            <TableColumn fx:id="regionColumn" prefWidth="125" text="Region"/>
            <TableColumn fx:id="totalAmountColumn" prefWidth="115" text="Total Amount"/>
            <TableColumn fx:id="statusColumn" prefWidth="115" text="Status"/>
            <TableColumn fx:id="receiptNoColumn" prefWidth="125" text="Receipt No"/>
            <TableColumn fx:id="submittedDateColumn" prefWidth="135" text="Submitted Date"/>
            <TableColumn fx:id="actionColumn" maxWidth="100" minWidth="80" prefWidth="90" resizable="false" text="Action"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>

    <HBox alignment="CENTER_LEFT" spacing="10" styleClass="table-pagination-bar" VBox.vgrow="NEVER">
        <Label styleClass="pagination-label" text="Rows per page"/>
        <ComboBox fx:id="itemsPerPageComboBox" prefWidth="76" styleClass="items-per-page-combo"/>
        <Label fx:id="paginationSummaryLabel" styleClass="pagination-summary" text="0 of 0 churches"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Pagination fx:id="submissionPagination" maxHeight="48"/>
    </HBox>

    <HBox alignment="CENTER_LEFT" spacing="14" styleClass="submission-totals-row">
        <Label styleClass="submission-totals-title" text="TOTALS"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label styleClass="submission-totals-label" text="Offerings"/>
        <Label fx:id="totalsOffertoryLabel" styleClass="submission-totals-value" text="0.00"/>
        <Label styleClass="submission-totals-label" text="Tithes"/>
        <Label fx:id="totalsTithesLabel" styleClass="submission-totals-value" text="0.00"/>
        <Label styleClass="submission-totals-label" text="Other Donations"/>
        <Label fx:id="totalsOtherDonationsLabel" styleClass="submission-totals-value" text="0.00"/>
        <Label styleClass="submission-totals-label" text="Grand Total"/>
        <Label fx:id="totalsGrandTotalLabel" styleClass="submission-totals-value-grand" text="0.00"/>
    </HBox>
</VBox>
