<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Pagination?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="14" styleClass="module-page"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.churchmanagement.controller.ReceiptHistoryController">
    <padding>
        <Insets bottom="22" left="22" right="22" top="22"/>
    </padding>

    <GridPane hgap="12" vgap="10">
        <columnConstraints>
            <ColumnConstraints minWidth="90" prefWidth="110"/>
            <ColumnConstraints minWidth="170" prefWidth="230"/>
            <ColumnConstraints minWidth="90" prefWidth="110"/>
            <ColumnConstraints minWidth="170" prefWidth="230"/>
            <ColumnConstraints minWidth="90" prefWidth="110"/>
            <ColumnConstraints hgrow="ALWAYS" minWidth="90" prefWidth="110"/>
        </columnConstraints>

        <Label text="Church" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <ComboBox fx:id="churchComboBox" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
        <Label text="Region" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
        <ComboBox fx:id="regionComboBox" maxWidth="Infinity" GridPane.columnIndex="3" GridPane.rowIndex="0"/>
        <Label text="Week" GridPane.columnIndex="4" GridPane.rowIndex="0"/>
        <DatePicker fx:id="weekStartDatePicker" maxWidth="Infinity" GridPane.columnIndex="5" GridPane.rowIndex="0"/>

        <Label text="Receipt No" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <TextField fx:id="receiptNoField" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
        <Label text="Status" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
        <ComboBox fx:id="statusComboBox" maxWidth="Infinity" GridPane.columnIndex="3" GridPane.rowIndex="1"/>
        <Label text="Week End" GridPane.columnIndex="4" GridPane.rowIndex="1"/>
        <Label fx:id="weekEndDateLabel" styleClass="value-label" text="-" GridPane.columnIndex="5" GridPane.rowIndex="1"/>

        <HBox alignment="CENTER_RIGHT" spacing="8" GridPane.columnIndex="4" GridPane.columnSpan="2" GridPane.rowIndex="2">
            <Button fx:id="searchButton" onAction="#handleSearch" styleClass="primary-button" text="Search"/>
            <Button fx:id="clearButton" onAction="#handleClear" text="Clear"/>
            <Button fx:id="refreshButton" onAction="#handleRefresh" text="Refresh"/>
        </HBox>
    </GridPane>

    <TableView fx:id="receiptTable" styleClass="receipt-history-table" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="receiptNoColumn" prefWidth="125" text="Receipt No"/>
            <TableColumn fx:id="churchColumn" prefWidth="230" text="Church"/>
            <TableColumn fx:id="regionColumn" prefWidth="95" text="Region"/>
            <TableColumn fx:id="weekColumn" prefWidth="245" text="Week"/>
            <TableColumn fx:id="statusColumn" prefWidth="145" text="Status"/>
            <TableColumn fx:id="totalColumn" prefWidth="120" text="Total"/>
            <TableColumn fx:id="actionColumn" maxWidth="215" minWidth="165" prefWidth="185" resizable="false" text="Action"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>

    <HBox alignment="CENTER_LEFT" spacing="10" styleClass="table-pagination-bar" VBox.vgrow="NEVER">
        <Label styleClass="pagination-label" text="Receipts per page"/>
        <ComboBox fx:id="receiptItemsPerPageComboBox" prefWidth="76" styleClass="items-per-page-combo"/>
        <Label fx:id="receiptPaginationSummaryLabel" styleClass="pagination-summary" text="0 of 0 Receipts"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Pagination fx:id="receiptPagination" maxHeight="48"/>
    </HBox>
</VBox>
