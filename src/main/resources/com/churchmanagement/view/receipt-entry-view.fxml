<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16" styleClass="module-page" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.churchmanagement.controller.ReceiptEntryController">
    <padding>
        <Insets bottom="22" left="22" right="22" top="22" />
    </padding>
   <children>
   
       <GridPane hgap="14" vgap="10">
           <columnConstraints>
               <ColumnConstraints minWidth="145" prefWidth="160" />
               <ColumnConstraints minWidth="230" prefWidth="280" />
               <ColumnConstraints minWidth="145" prefWidth="160" />
               <ColumnConstraints hgrow="ALWAYS" minWidth="230" prefWidth="320" />
           </columnConstraints>
      <children>
      
              <Label text="Church" GridPane.columnIndex="0" GridPane.rowIndex="0" />
              <ComboBox fx:id="churchComboBox" prefWidth="280" GridPane.columnIndex="1" GridPane.rowIndex="0" />
              <Label text="Region" GridPane.columnIndex="2" GridPane.rowIndex="0" />
              <Label fx:id="regionLabel" styleClass="value-label" text="-" GridPane.columnIndex="3" GridPane.rowIndex="0" />
      
              <Label text="Week Start Date" GridPane.columnIndex="0" GridPane.rowIndex="1" />
              <DatePicker fx:id="weekStartDatePicker" prefWidth="280" GridPane.columnIndex="1" GridPane.rowIndex="1" />
              <Label text="Week End Date" GridPane.columnIndex="2" GridPane.rowIndex="1" />
              <Label fx:id="weekEndDateLabel" styleClass="value-label" text="-" GridPane.columnIndex="3" GridPane.rowIndex="1" />
      
              <Label text="Date of Church Service" GridPane.columnIndex="0" GridPane.rowIndex="2" />
              <DatePicker fx:id="churchServiceDatePicker" prefWidth="280" GridPane.columnIndex="1" GridPane.rowIndex="2" />

              <Label text="Submitted By Name" GridPane.columnIndex="0" GridPane.rowIndex="3" />
              <TextField fx:id="submittedByNameField" promptText="Name of person submitting" GridPane.columnIndex="1" GridPane.rowIndex="3" />
              <Label text="Late Submission" GridPane.columnIndex="2" GridPane.rowIndex="3" />
              <Label fx:id="lateSubmissionLabel" styleClass="status-badge" text="NO" GridPane.columnIndex="3" GridPane.rowIndex="3" />

              <Label fx:id="lateReasonLabel" text="Late Submission Reason" GridPane.columnIndex="0" GridPane.rowIndex="4" />
              <TextArea fx:id="lateSubmissionReasonArea" prefRowCount="3" promptText="Reason for back week submission" wrapText="true" GridPane.columnIndex="1" GridPane.columnSpan="3" GridPane.rowIndex="4" />

              <Label fx:id="correctedFromLabel" text="Corrected From" GridPane.columnIndex="0" GridPane.rowIndex="5" />
              <Label fx:id="correctedFromValueLabel" styleClass="value-label" text="-" GridPane.columnIndex="1" GridPane.columnSpan="3" GridPane.rowIndex="5" />
      </children>
         <rowConstraints>
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
         </rowConstraints>
       </GridPane>
   
       <Label styleClass="section-title" text="Collection Items" />
   
       <GridPane hgap="12" vgap="10">
           <columnConstraints>
               <ColumnConstraints minWidth="145" prefWidth="170" />
               <ColumnConstraints minWidth="160" prefWidth="190" />
               <ColumnConstraints hgrow="ALWAYS" minWidth="260" prefWidth="420" />
           </columnConstraints>
      <children>
      
              <Label text="Offerings" GridPane.columnIndex="0" GridPane.rowIndex="0" />
              <TextField fx:id="offertoryAmountField" alignment="CENTER_RIGHT" promptText="Amount" GridPane.columnIndex="1" GridPane.rowIndex="0" />
              <TextField fx:id="offertoryNoteField" promptText="Note" GridPane.columnIndex="2" GridPane.rowIndex="0" />
      
              <Label text="Tithes" GridPane.columnIndex="0" GridPane.rowIndex="1" />
              <TextField fx:id="tithesAmountField" alignment="CENTER_RIGHT" promptText="Amount" GridPane.columnIndex="1" GridPane.rowIndex="1" />
              <TextField fx:id="tithesNoteField" promptText="Note" GridPane.columnIndex="2" GridPane.rowIndex="1" />
      
              <Label text="Other Donations" GridPane.columnIndex="0" GridPane.rowIndex="2" />
              <TextField fx:id="otherDonationsAmountField" alignment="CENTER_RIGHT" promptText="Amount" GridPane.columnIndex="1" GridPane.rowIndex="2" />
              <TextField fx:id="otherDonationsNoteField" promptText="Note" GridPane.columnIndex="2" GridPane.rowIndex="2" />
      
              <Label styleClass="section-title" text="Total Amount" GridPane.columnIndex="0" GridPane.rowIndex="3" />
              <Label fx:id="totalAmountLabel" alignment="CENTER_RIGHT" maxWidth="Infinity" styleClass="section-title" text="0.00" GridPane.columnIndex="1" GridPane.rowIndex="3" />
      </children>
         <rowConstraints>
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
         </rowConstraints>
       </GridPane>
   
       <HBox spacing="10">
      <children>
              <Button fx:id="saveAndPrintButton" onAction="#handleGenerateAndPrint" styleClass="primary-button" text="Generate &amp; Print Receipt" />
              <Button fx:id="saveButton" onAction="#handleGenerate" text="Generate Receipt" />
              <Button fx:id="clearButton" onAction="#handleClear" text="Clear" />
      </children>
       </HBox>
   
       <Label fx:id="messageLabel" styleClass="form-message" />
   </children>
</VBox>
