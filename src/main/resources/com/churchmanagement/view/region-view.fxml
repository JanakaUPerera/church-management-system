<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Pagination?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16" styleClass="module-page"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.churchmanagement.controller.RegionController">
    <padding>
        <Insets bottom="22" left="22" right="22" top="22"/>
    </padding>

    <HBox alignment="CENTER_RIGHT" spacing="10">
        <Button fx:id="saveButton" onAction="#handleSave" styleClass="primary-button" text="New Region"/>
    </HBox>

    <HBox alignment="CENTER_LEFT" spacing="10">
        <TextField fx:id="searchField" HBox.hgrow="ALWAYS" onAction="#handleSearch" promptText="Search by code or name"/>
        <Button onAction="#handleSearch" text="Search"/>
        <Button onAction="#handleRefresh" text="Refresh"/>
    </HBox>

    <TableView fx:id="regionTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="codeColumn" prefWidth="140" text="Region Code"/>
            <TableColumn fx:id="nameColumn" prefWidth="260" text="Region Name"/>
            <TableColumn fx:id="statusColumn" prefWidth="120" text="Status"/>
            <TableColumn fx:id="createdAtColumn" prefWidth="170" text="Created At"/>
            <TableColumn fx:id="actionColumn" prefWidth="130" text="Action"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>

    <HBox alignment="CENTER_LEFT" spacing="10" styleClass="table-pagination-bar" VBox.vgrow="NEVER">
        <Label styleClass="pagination-label" text="Regions per page"/>
        <ComboBox fx:id="regionItemsPerPageComboBox" prefWidth="76" styleClass="items-per-page-combo"/>
        <Label fx:id="regionPaginationSummaryLabel" styleClass="pagination-summary" text="0 of 0 Regions"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Pagination fx:id="regionPagination" maxHeight="48"/>
    </HBox>

    <Label fx:id="messageLabel" styleClass="form-message"/>
</VBox>
